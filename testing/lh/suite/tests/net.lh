# std.binary and std.net -- networking is standard, as LuaSocket and ENet
# came with LOVE. The packing is checked against the example in lhat's
# DesignDocuments/11-binary-and-net.md (3.4), byte for byte.
module^suite.tests.net

import^love.data
import^std.binary
import^std.net

let^test = require^"../lib/test.lh"

# A format carries the table type it packs: encode takes one, decode
# answers one, and got.aaa is checked like any field.
let^Input = t^{ aaa:number^, bbb:number^, buttonA:bool^, buttonB:bool^, buttonC:bool^ }
let^input = std.binary.format(Input, {
    { "aaa", std.binary.uint(16) },
    { "bbb", std.binary.uint(8) },
    { "buttonA", std.binary.bool() },
    { "buttonB", std.binary.bool() },
    { "buttonC", std.binary.bool() },
})

# decode answers the table or a std.binary.Error; try^ needs a procedure
# whose answer can carry the error.
let^readsBack = p^data:string^ -> bool^|std.binary.Error {
    let^got, _^ = try^input.decode(data, 0)
    return^got.aaa = 11111 and^got.bbb = 111
        and^got.buttonA = true^ and^got.buttonB = true^ and^got.buttonC = false^
}

# One datagram over the loopback: `a` binds port 0, `b` sends to the port it
# got. receive never waits (11 の 4.2), so it is polled a bounded number of
# times rather than assumed to be there.
let^loopback = p^-> string^|std.net.Error {
    let^a = try^std.net.udp()
    let^b = try^std.net.udp()
    try^a.bind("127.0.0.1", 0)
    let^host, port = a.getLocal()
    try^b.sendTo("hello", "127.0.0.1", port)
    for^i from^0 to^100000 {
        let^data, from, fromPort = try^a.receive()
        if^data fits^string^ {
            a.dispose()
            b.dispose()
            return^data
        }
    }
    a.dispose()
    b.dispose()
    return^"(nothing arrived)"
}

public^let^run = p^{
    test.begin("std.binary")

    let^data = input.encode({
        aaa = 11111, bbb = 111,
        buttonA = true^, buttonB = true^, buttonC = false^,
    })
    test.number("27 bits fill 4 bytes", 4, data.size)
    # Low bits first, low bytes first: 11111 = 0x2B67, 111 = 0x6F, then the
    # buttons in bits 0..2 of the last byte.
    test.text("packed low bits first", "672b6f03", love.data.encode(love.data.EncodeFormat.hex, data))
    test.isTrue("decode reads every field back", readsBack(data) catch^false^)

    test.begin("std.net")
    test.text("a datagram crosses the loopback", "hello", loopback() catch^"(net error)")
}
