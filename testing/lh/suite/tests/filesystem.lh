# love.filesystem -- the L^port of testing/tests/filesystem.lua, for the
# save-directory and mount APIs (lines still waits for its binding).
# Every failable call answers an error value, so each one is written with
# catch^the way a game would write it.
module^suite.tests.filesystem

import^love.filesystem

let^test = require^"../lib/test.lh"

public^let^run = p^{
    test.begin("love.filesystem")

    test.isTrue("the identity is set", love.filesystem.getIdentity().length > 0)
    test.isTrue("the source is set", love.filesystem.getSource().length > 0)
    test.isFalse("a game directory is not fused", love.filesystem.isFused())

    # write, read back, and the info about it
    let^written = love.filesystem.write("suite.txt", "hello suite") catch^"failed"
    test.isTrue("write answers no error", written fits^nil^)
    test.text("read", "hello suite", love.filesystem.read("suite.txt") catch^"(failed)")
    test.text("read with a length", "hello", love.filesystem.read("suite.txt", 5) catch^"(failed)")
    test.isTrue("exists", love.filesystem.exists("suite.txt"))

    let^info = love.filesystem.getInfo("suite.txt")
    if^info = nil^{
        test.isTrue("getInfo answers a table", false^)
    else^:
        test.isTrue("info type", love.filesystem.FileType.file = info.type)
        test.number("info size", 11, info.size)
    }
    test.isTrue("getInfo on nothing answers nil^", love.filesystem.getInfo("no-such-file.txt") fits^nil^)

    # append
    love.filesystem.append("suite.txt", "!") catch^nil^
    test.text("append", "hello suite!", love.filesystem.read("suite.txt") catch^"(failed)")

    # directories
    test.isTrue("createDirectory", love.filesystem.createDirectory("suitedir"))
    love.filesystem.write("suitedir/inner.txt", "inner") catch^nil^
    var^found = false^
    for^name in^love.filesystem.getDirectoryItems("suitedir") {
        if^name = "inner.txt" { found := true^}
    }
    test.isTrue("getDirectoryItems lists what is there", found)
    let^dirinfo = love.filesystem.getInfo("suitedir")
    if^dirinfo = nil^{
        test.isTrue("a directory has info", false^)
    else^:
        test.isTrue("info type of a directory", love.filesystem.FileType.directory = dirinfo.type)
    }

    # a real directory backs the save file
    test.isTrue("getRealDirectory finds the save file", !(love.filesystem.getRealDirectory("suite.txt") fits^nil^))

    # reading what is not there is an error value, not a panic
    let^missing = love.filesystem.read("no-such-file.txt") catch^"(caught)"
    test.text("a missing file answers an error", "(caught)", missing)

    # 04 の 2.4: the failures belong to the module, so a game may ask for the
    # declaration rather than naming the variant it happens to be.
    let^byGroup = love.filesystem.read("no-such-file.txt") catch^ if^ it^ fits^ love.filesystem.Error: "(by declaration)" el^: "(other)";
    test.text("the module's declaration catches it", "(by declaration)", byGroup)
    let^byLeaf = love.filesystem.read("no-such-file.txt") catch^ if^ it^ fits^ love.filesystem.Error.IO: "(by leaf)" el^: "(other)";
    test.text("and so does the variant", "(by leaf)", byLeaf)

    # Mount a save-directory ZIP, and check search order against a loose file.
    let^zip = love.filesystem.read("assets/mount.zip") catch^""
    love.filesystem.write("suite-mount.zip", zip) catch^nil^
    love.filesystem.write("mount-value.txt", "loose") catch^nil^
    test.isTrue("mount ZIP at root", love.filesystem.mount("suite-mount.zip", ""))
    test.text("mount prepends by default", "archive", love.filesystem.read("mount-value.txt") catch^"(failed)")
    test.isFalse("duplicate mount fails", love.filesystem.mount("suite-mount.zip", "mounted"))
    test.isTrue("unmount ZIP by path", love.filesystem.unmount("suite-mount.zip"))
    test.text("unmount restores search order", "loose", love.filesystem.read("mount-value.txt") catch^"(failed)")
    test.isTrue("mount ZIP appended", love.filesystem.mount("suite-mount.zip", "", true^))
    test.text("append preserves earlier files", "loose", love.filesystem.read("mount-value.txt") catch^"(failed)")
    test.isTrue("unmount appended ZIP", love.filesystem.unmount("suite-mount.zip"))
    test.isFalse("unmount twice fails", love.filesystem.unmount("suite-mount.zip"))
    test.isFalse("mount missing archive fails", love.filesystem.mount("missing-mount.zip", "mounted"))
    test.isFalse("mount invalid archive fails", love.filesystem.mount("suite.txt", "mounted"))

    test.isTrue("mount directory", love.filesystem.mount("suitedir", "mounted", false^))
    test.text("read mounted directory", "inner", love.filesystem.read("mounted/inner.txt") catch^"(failed)")
    test.isTrue("unmount directory", love.filesystem.unmount("suitedir"))
    test.isFalse("unmounted files disappear", love.filesystem.exists("mounted/inner.txt"))

    # Memory archives accept a FileData filename or an explicit archive name.
    let^archive = love.filesystem.newFileData(zip, "memory-mount.zip")
    test.isTrue("mount FileData", love.filesystem.mount(archive, "memory"))
    test.text("read memory archive", "archive", love.filesystem.read("memory/mount-value.txt") catch^"(failed)")
    test.isTrue("unmount FileData by name", love.filesystem.unmount("memory-mount.zip"))
    test.isTrue("mount FileData appended", love.filesystem.mount(archive, "memory", true^))
    test.isTrue("unmount FileData by object", love.filesystem.unmount(archive))
    test.isFalse("unmounted memory files disappear", love.filesystem.exists("memory/mount-value.txt"))
    test.isFalse("unmount unmounted FileData fails", love.filesystem.unmount(archive))
    test.isTrue("mount explicitly named FileData", love.filesystem.mount(archive, "named-mount.zip", "memory"))
    test.isTrue("unmount explicit name", love.filesystem.unmount("named-mount.zip"))
    test.isTrue("mount explicitly named FileData appended", love.filesystem.mount(archive, "named-mount.zip", "memory", true^))
    test.isTrue("unmount named FileData by object", love.filesystem.unmount(archive))
    test.isFalse("mount invalid FileData fails", love.filesystem.mount(love.filesystem.newFileData("not a ZIP", "invalid.zip"), "memory"))
    test.isTrue("remove archive fixture", love.filesystem.remove("suite-mount.zip"))
    test.isTrue("remove loose mount file", love.filesystem.remove("mount-value.txt"))

    # tidy up
    test.isTrue("remove a file", love.filesystem.remove("suitedir/inner.txt"))
    test.isTrue("remove a directory", love.filesystem.remove("suitedir"))
    test.isTrue("remove the test file", love.filesystem.remove("suite.txt"))
    test.isFalse("what was removed is gone", love.filesystem.exists("suite.txt"))
}
