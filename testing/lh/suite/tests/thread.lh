# std.thread and std.channel (the language's, not love's) and love.video --
# the L^ port of testing/tests/thread.lua and video.lua. The worker here is
# short and joined at once, so the suite stays a single frame's worth of work.
#
# Every call that can run out of memory answers a union, and 04 の 4.5's
# catch^ arm is what reads one: try^ takes the value out and a refusal goes
# to the arm at the end of the do^{ }, so the body reads as though nothing
# could fail. fits^ is left for the places where the error IS the assertion.
module^suite.tests.thread

import^std.thread
import^std.channel
import^love.graphics
import^love.timer

let^test = require^"../lib/test.lh"

public^let^run = p^{
    test.begin("std.channel")

    do^{
        let^made = try^std.channel.new()
        test.number("a fresh channel is empty", 0, made.count())

        let^id = try^made.push(42)
        test.isTrue("push answers an id", id > 0)
        test.number("one value waiting", 1, made.count())
        let^peeked = made.peek()
        if^peeked fits^number^{
            test.number("peek answers without taking", 42, peeked)
        else^:
            test.isTrue("peek answers the number", false^)
        }
        test.number("peek left it there", 1, made.count())
        let^popped = made.pop()
        if^popped fits^number^{
            test.number("pop answers the number", 42, popped)
        else^:
            test.isTrue("pop answers the number", false^)
        }
        test.number("pop took it", 0, made.count())
        test.isTrue("popping an empty channel answers nil^", made.pop() fits^nil^)

        # carry keeps an integer whole, which love's Variant could not
        let^_^= try^made.push(7)
        let^whole = made.pop()
        test.isTrue("an integer crosses as an integer", whole fits^number^and^whole = 7)

        # a table crosses as a copy
        let^_^= try^made.push({ name = "carried", count = 3 })
        let^table = made.pop()
        if^table fits^t^{ name : string^, count : number^} {
            test.text("a table carries its strings", "carried", table.name)
            test.number("and its numbers", 3, table.count)
        else^:
            test.isTrue("a table crosses a channel", false^)
        }

        # 05 の 8.8改2: a LOVE object crosses as its pointer -- every object
        # type declares the sharing contract, so all of them may
        let^image = (love.graphics.newImage("assets/love.png") catch^nil^)
        if^image = nil^{
            test.isTrue("newImage reads the file", false^)
        else^:
            let^_^= try^made.push(image)
            let^back = made.pop()
            if^back fits^love.graphics.Texture {
                test.isTrue("a LOVE object crosses as itself", back = image)
                test.number("and answers the same", image.getWidth(), back.getWidth())
            else^:
                test.isTrue("a LOVE object crosses a channel", false^)
            }
        }

        # atomic runs with the channel held
        var^inside = 0
        made.atomic(p^c:std.channel.Channel {
            let^_1 = c.push("first")
            let^_2 = c.push("second")
            inside := c.count()
        })
        test.number("atomic saw both pushes", 2, inside)
        made.clear()
        test.number("clear empties the channel", 0, made.count())

        # named channels are shared by name, and outlive any one machine
        let^named = try^std.channel.named("suite")
        let^_^= try^named.push("hello")
        test.number("the same name answers the same channel", 1, (try^std.channel.named("suite")).count())
        named.clear()

        test.begin("std.thread")

        # a worker from a closure of this very unit, given its work through a
        # named channel. The body names std.channel because this unit imported
        # it -- an import^ root is read off the worker's own L^.modules.
        let^worker = try^std.thread.spawn(p^ ... {
            let^outbox = try^std.channel.named("suite.out")
            let^n = ...[0]
            if^n fits^number^{ try^outbox.push(n * 2) }
            let^_^= try^outbox.push("done")
            return^"worked"
        catch^:
            return^"the worker could not reach its channel"
        }, 21)
        let^answer = try^worker.join()
        if^answer fits^string^{
            test.text("join answers what the body returned", "worked", answer)
        else^:
            test.isTrue("join answers the string", false^)
        }
        test.isTrue("a joined thread is done", worker.done())
        test.isTrue("a thread that worked has no error", worker.failed() fits^nil^)
        # here the error IS the assertion, so the union is read as it stands
        test.isTrue("joining twice says so", worker.join() fits^std.thread.ThreadError.AlreadyJoined)
        worker.dispose()

        let^out = try^std.channel.named("suite.out")
        let^doubled = out.pop()
        test.isTrue("the thread did the work", doubled fits^number^and^doubled = 42)
        let^word = out.pop()
        if^word fits^string^{
            test.text("and said so", "done", word)
        else^:
            test.isTrue("the thread answered a string", false^)
        }
        out.clear()

        # a body that panicked keeps its message for failed()
        let^broken = try^std.thread.spawn(p^ ... { panic^"suite thread" })
        test.isTrue("a body that panicked answers an error",
                    broken.join() fits^std.thread.ThreadError.BadResult)
        let^why = broken.failed()
        if^why fits^string^{
            test.isTrue("a thread that failed says why", why.length > 0)
        else^:
            test.isTrue("a thread that failed has an error", false^)
        }
        broken.dispose()
    catch^:
        test.isTrue($"std.channel and std.thread answered: {it^.message}", false^)
    }

    test.begin("love.video")

    let^video = love.graphics.newVideo("assets/sample.ogv", { audio = false^}) catch^nil^
    if^video = nil^{
        test.isTrue("newVideo reads the file", false^)
    else^:
        test.text("type", "Video", video.type())
        test.isTrue("the video has a width", video.getWidth() > 0)
        let^w, h = video.getDimensions()
        test.number("getDimensions agrees", video.getWidth(), w)
        test.isTrue("it knows its filename", video.getFilename().length > 0)
        test.isFalse("a fresh video is not playing", video.isPlaying())
        video.play()
        test.isTrue("play starts it", video.isPlaying())
        video.pause()
        test.isFalse("pause stops it", video.isPlaying())
        video.seek(0.2)
        test.near("seek then tell", 0.2, video.tell(), 0.1)
        video.rewind()
        test.near("rewind goes back to the start", 0, video.tell(), 0.05)
        test.isTrue("no audio source was asked for", video.getSource() fits^nil^)
    }
}
