# love.audio and love.sound -- the L^port of testing/tests/audio.lua and
# sound.lua, for what is bound (effects, filters and queueable sources
# wait for theirs).
module^suite.tests.audio

import^love.audio
import^love.sound

let^test = require^"../lib/test.lh"

public^let^run = p^{
    test.begin("love.sound")

    let^data = love.sound.newSoundData("assets/tone.ogg") catch^nil^
    if^data = nil^{
        test.isTrue("newSoundData reads the file", false^)
    else^:
        test.isTrue("the sound has samples", data.getSampleCount() > 0)
        test.isTrue("the sample rate is sensible", data.getSampleRate() >= 8000)
        test.isTrue("the bit depth is 8 or 16", data.getBitDepth() = 8 or^data.getBitDepth() = 16)
        test.range("channels", data.getChannelCount(), 1, 2)
        test.near("the duration matches the samples", data.getSampleCount() / data.getSampleRate(), data.getDuration(), 0.01)
        test.text("type", "SoundData", data.type())
        test.isTrue("typeOf its own type", data.typeOf("SoundData"))
    }

    # newSoundData(samples, rate, bits, channels) makes silence
    let^made = love.sound.newSoundData(1000, 44100, 16, 1)
    test.number("the sample count is what was asked", 1000, made.getSampleCount())
    test.number("the rate is what was asked", 44100, made.getSampleRate())

    test.begin("love.audio")

    let^source = love.audio.newSource("assets/tone.ogg", love.audio.SourceType.static) catch^nil^
    if^source = nil^{
        test.isTrue("newSource reads the file", false^)
    else^:
        test.text("type", "Source", source.type())
        test.isFalse("a fresh source is not playing", source.isPlaying())
        test.isTrue("the source has a duration", source.getDuration() > 0)
        test.range("channels", source.getChannelCount(), 1, 2)

        # volume, pitch and looping round trip
        source.setVolume(0.25)
        test.near("volume", 0.25, source.getVolume(), 0.001)
        source.setPitch(1.5)
        test.near("pitch", 1.5, source.getPitch(), 0.001)
        source.setLooping(true^)
        test.isTrue("looping", source.isLooping())
        source.setLooping(false^)

        # playing and stopping
        source.setVolume(0)
        test.isTrue("play answers true", source.play())
        test.isTrue("a played source is playing", source.isPlaying())
        test.isTrue("the module counts it", love.audio.getActiveSourceCount() >= 1)
        source.pause()
        test.isFalse("a paused source is not playing", source.isPlaying())
        source.stop()
        test.isFalse("a stopped source is not playing", source.isPlaying())

        # seek and tell
        source.seek(0.05)
        test.near("seek then tell", 0.05, source.tell(), 0.02)
        source.seek(0.05, love.audio.TimeUnit.seconds)
        test.near("explicit time unit", 0.05, source.tell(love.audio.TimeUnit.seconds), 0.02)
        test.isTrue("duration in samples", source.getDuration(love.audio.TimeUnit.samples) > 0)

        # a clone is a source of its own
        let^twin = source.clone()
        test.text("a clone is a Source", "Source", twin.type())
        test.near("the clone keeps the volume", source.getVolume(), twin.getVolume(), 0.001)
    }

    # the module's own volume
    let^volume = love.audio.getVolume()
    love.audio.setVolume(0.5)
    test.near("the module volume round trips", 0.5, love.audio.getVolume(), 0.001)
    love.audio.setVolume(volume)
}
