# love.physics -- the L^port of testing/tests/physics.lua. The binding gives
# L^ World, Body and Contact, plus Shape and Joint with box2d's kinds under
# them as types of their own (the deprecated body-less shapes and newFixture
# have no L^spelling at all).
module^suite.tests.physics

import^love.physics

let^test = require^"../lib/test.lh"

public^let^run = p^{
    test.begin("love.physics")

    # the meter round trips
    let^meter = love.physics.getMeter()
    love.physics.setMeter(64)
    test.number("setMeter round trips", 64, love.physics.getMeter())

    let^world = love.physics.newWorld(0, 100, true^)
    test.text("type", "World", world.type())
    let^gx, gy = world.getGravity()
    test.number("gravity x", 0, gx)
    test.number("gravity y", 100, gy)
    world.setGravity(0, 200)
    let^_gx2, gy2 = world.getGravity()
    test.number("setGravity", 200, gy2)
    world.setGravity(0, 100)
    test.isTrue("sleeping is allowed", world.isSleepingAllowed())
    test.isFalse("a fresh world is not locked", world.isLocked())
    test.number("no bodies yet", 0, world.getBodyCount())

    # bodies
    let^ground, groundShape = love.physics.newRectangleBody(world, love.physics.BodyType.static, 200, 400, 400, 20)
    let^box, boxShape = love.physics.newRectangleBody(world, love.physics.BodyType.dynamic, 200, 100, 40, 40)
    let^ball, ballShape = love.physics.newCircleBody(world, love.physics.BodyType.dynamic, 260, 100, 20)
    test.number("three bodies", 3, world.getBodyCount())
    test.isTrue("body type", love.physics.BodyType.static = ground.getType())
    test.isTrue("dynamic body type", love.physics.BodyType.dynamic = box.getType())
    test.isTrue("a dynamic body has mass", box.getMass() > 0)
    test.number("the ground has none", 0, ground.getMass())

    let^bx, by = box.getPosition()
    test.number("position x", 200, bx)
    test.number("position y", 100, by)
    box.setPosition(210, 90)
    let^bx2, by2 = box.getPosition()
    test.number("setPosition x", 210, bx2)
    test.number("setPosition y", 90, by2)
    box.setAngle(1)
    test.near("setAngle", 1, box.getAngle(), 0.001)
    box.setTransform(200, 100, 0)
    let^tx, ty, ta = box.getTransform()
    test.isTrue("setTransform sets all three", tx = 200 and^ty = 100 and^ta = 0)

    box.setLinearVelocity(5, 6)
    let^vx, vy = box.getLinearVelocity()
    test.number("linear velocity x", 5, vx)
    test.number("linear velocity y", 6, vy)
    box.setAngularVelocity(2)
    test.near("angular velocity", 2, box.getAngularVelocity(), 0.001)
    box.setLinearVelocity(0, 0)
    box.setAngularVelocity(0)

    box.setBullet(true^)
    test.isTrue("bullet", box.isBullet())
    box.setBullet(false^)
    box.setFixedRotation(true^)
    test.isTrue("fixed rotation", box.isFixedRotation())
    box.setFixedRotation(false^)
    test.isTrue("a fresh body is awake", box.isAwake())
    test.isTrue("and active", box.isActive())

    # local and world points
    let^wx, wy = box.getWorldPoint(0, 0)
    test.number("the body's own origin is its position", 200, wx)
    let^lx, ly = box.getLocalPoint(200, 100)
    test.isTrue("and back again", lx = 0 and^ly = 0)
    let^points = box.getWorldPoints(0, 0, 10, 0)
    test.number("getWorldPoints answers a pair per point", 4, points.length^)

    # shapes
    test.isTrue("shape type", love.physics.ShapeType.polygon = boxShape.getType())
    test.isTrue("circle shape type", love.physics.ShapeType.circle = ballShape.getType())
    test.number("the circle's radius", 20, ballShape.getRadius())
    test.isTrue("a shape knows its body", ballShape.getBody() = ball)
    test.number("the body knows its shapes", 1, box.getShapes().length^)

    # 05 の 8.8改: box2d's kinds are types, so what a constructor answers is
    # the kind it made and the members of one kind stay off the others.
    test.isTrue("a rectangle body makes a polygon shape", boxShape fits^love.physics.PolygonShape)
    test.isTrue("a circle body makes a circle shape", ballShape fits^love.physics.CircleShape)
    test.isTrue("and both are Shapes", boxShape fits^love.physics.Shape and^ballShape fits^love.physics.Shape)
    test.isFalse("a polygon is not a circle", boxShape fits^love.physics.CircleShape)
    let^ccx, ccy = ballShape.getPoint()
    test.number("a circle centre x", 0, ccx)
    test.number("its centre y", 0, ccy)
    test.number("a polygon's points come in pairs", 8, boxShape.getPoints().length^)
    boxShape.setFriction(0.3)
    test.near("friction", 0.3, boxShape.getFriction(), 0.001)
    boxShape.setRestitution(0.4)
    test.near("restitution", 0.4, boxShape.getRestitution(), 0.001)
    boxShape.setDensity(2)
    test.near("density", 2, boxShape.getDensity(), 0.001)
    box.resetMassData()
    boxShape.setSensor(true^)
    test.isTrue("sensor", boxShape.isSensor())
    boxShape.setSensor(false^)
    test.isTrue("a point inside the box is inside", boxShape.testPoint(200, 100))
    test.isFalse("a point far away is not", boxShape.testPoint(0, 0))
    let^px = boxShape.getPoints()
    test.number("a rectangle has four corners", 8, px.length^)

    # filter bits are 1-based indices in L^
    boxShape.setCategory(3)
    test.number("one category bit", 1, boxShape.getCategory().length^)
    boxShape.setMask(2, 4)
    test.number("two mask bits", 2, boxShape.getMask().length^)
    boxShape.setGroupIndex(-2)
    test.number("group index", -2, boxShape.getGroupIndex())
    boxShape.setCategory(1)
    boxShape.setMask()
    boxShape.setGroupIndex(0)

    let^lowx, lowy, highx, highy = boxShape.getBoundingBox()
    test.isTrue("the bounding box holds the shape", lowx < 200 and^highx > 200)
    let^cx, cy, mass, inertia = boxShape.getMassData()
    test.isTrue("the mass data has mass", mass > 0)

    # user data is any L^value
    boxShape.setUserData("the box")
    let^data = boxShape.getUserData()
    if^data fits^string^{
        test.text("shape user data", "the box", data)
    else^:
        test.isTrue("shape user data comes back as it went in", false^)
    }
    box.setUserData({ name = "box", hits = 0 })
    let^bodydata = box.getUserData()
    if^bodydata fits^t^{ name : string^, hits : number^} {
        test.text("body user data", "box", bodydata.name)
    else^:
        test.isTrue("body user data comes back as a table", false^)
    }

    # joints
    let^joint = love.physics.newDistanceJoint(box, ball, 200, 100, 260, 100, false^)
    test.isTrue("joint type", love.physics.JointType.distance = joint.getType())
    test.number("the joint's length", 60, joint.getLength())
    let^ax1, ay1, ax2, ay2 = joint.getAnchors()
    test.number("anchor x", 200, ax1)
    test.number("the other anchor x", 260, ax2)
    let^bodyA, bodyB = joint.getBodies()
    test.isTrue("the joint knows its bodies", bodyA = box and^bodyB = ball)
    # 8.8: a hostdata is equal by tag and pointer, so a wrapper built by one
    # getter and a wrapper built by another compare equal and hash alike.
    # `is^` -- the same wrapper -- is deliberately NOT promised: the binding
    # answers a fresh one each time, because a host-held cache of them is
    # unsound under an incremental collector (see lh.h).
    let^againA, _againB = joint.getBodies()
    test.isTrue("a getter answers an equal wrapper", againA = bodyA)
    test.isTrue("and one equal to the body itself", againA = box)
    test.isFalse("collideConnected", joint.getCollideConnected())
    joint.setUserData("the joint")
    test.number("the world counts the joint", 1, world.getJointCount())
    test.number("the body lists it", 1, box.getJoints().length^)

    # 8.8改: a joint kind is a type, so its own members are reachable only
    # through it -- getLength here is DistanceJoint's and nowhere else.
    test.isTrue("a distance joint is one", joint fits^love.physics.DistanceJoint)
    test.isTrue("and it is a Joint", joint fits^love.physics.Joint)
    test.isFalse("it is not a revolute joint", joint fits^love.physics.RevoluteJoint)
    joint.setLength(50)
    test.number("setLength", 50, joint.getLength())

    # stepping the world moves what falls
    let^before = ball.getY()
    for^i from^1 to^30 { world.update(1 / 60) }
    test.isTrue("gravity moved the ball down", ball.getY() > before)

    # queries
    var^visited = 0
    world.queryShapesInArea(0, 380, 400, 420, p^s:love.physics.Shape -> bool^{
        visited := visited + 1
        return^true^
    })
    test.isTrue("the area query found the ground", visited >= 1)
    test.isTrue("getShapesInArea agrees", world.getShapesInArea(0, 380, 400, 420).length^>= 1)

    var^hits = 0
    world.rayCast(200, 0, 200, 500, p^s:love.physics.Shape, x:number^, y:number^, nx:number^, ny:number^, fraction:number^-> number^{
        hits := hits + 1
        return^1
    })
    test.isTrue("the ray hit something", hits >= 1)
    let^closest = world.rayCastClosest(200, 0, 200, 500)
    if^closest fits^t^{ shape : love.physics.Shape, x : number^, y : number^, nx : number^, ny : number^, fraction : number^} {
        test.range("the closest hit is on the ray", closest.fraction, 0, 1)
    else^:
        test.isTrue("rayCastClosest answers a hit", false^)
    }
    test.isTrue("a ray into nothing answers nil^", world.rayCastClosest(0, 0, 0, 1) fits^nil^)

    # the distance between two shapes
    let^distance, dx1, dy1, dx2, dy2 = love.physics.getDistance(boxShape, groundShape)
    test.isTrue("the distance is not negative", distance >= 0)

    # destroying
    joint.destroy()
    test.isTrue("a destroyed joint says so", joint.isDestroyed())
    test.number("the world no longer counts it", 0, world.getJointCount())
    ball.destroy()
    test.isTrue("a destroyed body says so", ball.isDestroyed())
    test.number("the world no longer counts it", 2, world.getBodyCount())
    world.destroy()
    test.isTrue("a destroyed world says so", world.isDestroyed())

    love.physics.setMeter(meter)
}
