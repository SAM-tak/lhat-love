# love.keyboard, love.mouse, love.joystick, love.touch and love.sensor --
# the L^port of testing/tests/{keyboard,mouse,joystick,touch,sensor}.lua.
# Nothing is pressed while the suite runs, so these check the state the
# engine reports and the settings that round trip.
module^suite.tests.input

import^love.keyboard
import^love.mouse
import^love.joystick
import^love.touch
import^love.sensor

let^test = require^"../lib/test.lh"

public^let^run = p^{
    test.begin("love.keyboard")

    let^repeats = love.keyboard.hasKeyRepeat()
    love.keyboard.setKeyRepeat(!repeats)
    test.isTrue("setKeyRepeat round trips", love.keyboard.hasKeyRepeat() = !repeats)
    love.keyboard.setKeyRepeat(repeats)

    let^typing = love.keyboard.hasTextInput()
    love.keyboard.setTextInput(!typing)
    test.isTrue("setTextInput round trips", love.keyboard.hasTextInput() = !typing)
    love.keyboard.setTextInput(typing)

    test.isFalse("no key is down", love.keyboard.isDown("a"))
    test.isFalse("no scancode is down", love.keyboard.isScancodeDown("a"))

    test.begin("love.mouse")

    love.mouse.setPosition(30, 40)
    let^x, y = love.mouse.getPosition()
    test.number("setPosition x", 30, x)
    test.number("setPosition y", 40, y)
    test.number("getX agrees", x, love.mouse.getX())
    test.number("getY agrees", y, love.mouse.getY())

    let^visible = love.mouse.isVisible()
    love.mouse.setVisible(!visible)
    test.isTrue("setVisible round trips", love.mouse.isVisible() = !visible)
    love.mouse.setVisible(visible)

    test.isFalse("no mouse button is down", love.mouse.isDown(1))

    test.begin("love.joystick")

    let^button : any^ = love.joystick.GamepadButton.a
    test.isTrue("gamepad buttons have a nominal type", button fits^love.joystick.GamepadButton)
    test.isFalse("a button is not an axis", button fits^love.joystick.GamepadAxis)

    # Check these signatures even when no physical controller is connected.
    let^readGamepad = f^stick:love.joystick.Joystick -> bool^ {
        return^stick.isGamepadDown(love.joystick.GamepadButton.a, love.joystick.GamepadButton.b)
            or^stick.getGamepadAxis(love.joystick.GamepadAxis.leftx) > 0.5
    }

    let^sticks = love.joystick.getJoysticks()
    test.number("getJoystickCount agrees with the list", sticks.length^, love.joystick.getJoystickCount())
    for^stick in^sticks {
        test.isTrue("a listed joystick is connected", stick.isConnected())
        test.isTrue("a joystick has a name", stick.getName().length > 0)
        test.isTrue("a joystick has a GUID", stick.getGUID().length > 0)
        test.isTrue("axis count is not negative", stick.getAxisCount() >= 0)
        test.isTrue("button count is not negative", stick.getButtonCount() >= 0)
        if^stick.isGamepad() { readGamepad(stick) }
    }

    test.begin("love.touch")

    let^touches = love.touch.getTouches()
    test.number("no touches on a desktop", 0, touches.length^)

    test.begin("love.sensor")

    for^kind in^{ love.sensor.SensorType.accelerometer, love.sensor.SensorType.gyroscope } {
        let^has = love.sensor.hasSensor(kind)
        if^has {
            test.isFalse($"{kind} starts disabled", love.sensor.isEnabled(kind))
        else^:
            test.isFalse($"{kind} is absent, so it is not enabled", love.sensor.isEnabled(kind))
        }
    }
}
